# LLM (OpenRouter, OpenAI-compatible API)
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-3.8-flash
LLM_TIMEOUT_SECONDS=60

# Observability (optional: leave empty to disable tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Web search (free tier at tavily.com; DuckDuckGo fallback if empty)
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5

# Research workflow
CHECKPOINT_DB=data/checkpoints.sqlite
MAX_REVISIONS=1
